; Godot 4.7.2 — Opus vs Sol
config_version=5

[application]
config/name="Неоновый прилив"
config/use_custom_user_dir=true
config/custom_user_dir_name="NeonTide"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/size/borderless=true
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/vram_compression/import_s3tc_bptc=true
lights_and_shadows/directional_shadow/size=2048
mesh_lod/lod_change/threshold_pixels=2.0
scaling_3d/scale=0.7
scaling_3d/mode=1
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.5, 0.7, 0.8, 1)

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true

[debug]
file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false

[network]
tls/certificate_bundle_override="res://tools/certificates.pem"
